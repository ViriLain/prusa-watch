# Copy to .env and fill in. Never commit .env.
PRUSALINK_PASSWORD=
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Separate random topic for Keep printing / Pause now replies (generate: echo "pw-reply-$(openssl rand -hex 12)")
NTFY_REPLY_TOPIC=
DISCORD_WEBHOOK_URL=
WEBHOOK_URL=
# LAN URL of the machine running prusa-watch; enables Resume/Cancel buttons in ntfy
PUBLIC_URL=http://192.168.1.10:8484
# Dead-man's switch (e.g. healthchecks.io): pinged while prusa-watch can protect a print
HEARTBEAT_URL=
HEARTBEAT_FAIL_URL=
# Shared secret for pause/resume/stop endpoints (generate: openssl rand -base64 18)
WEB_TOKEN=

# Any setting can also be overridden here without touching config.yaml:
#   PRUSA_WATCH__<SECTION>__<KEY>=value   (value parsed as YAML)
# e.g. PRUSA_WATCH__ESCALATION__DEFAULT_POLICY=watch_only
#      PRUSA_WATCH__DECISION__SENSITIVITY=1.25
